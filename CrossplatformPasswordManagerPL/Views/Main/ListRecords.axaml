<Page xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	         xmlns:assets="clr-namespace:CrossplatformPasswordManagerPL.Assets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	         x:Class="CrossplatformPasswordManagerPL.Views.Main.ListRecords"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"       
             NavigationBar.Visible="False"
			 xmlns:vm="clr-namespace:CrossplatformPasswordManagerPL.ViewModels.Main"
			 x:DataType="vm:ListRecordsViewModel">
	<Page.Resources>
		<StackPanel x:Key="{x:Static assets:Resources.RemoveRecordDialogId}">
			<TextBlock Text="{x:Static assets:Resources.RemoveQuestionText}"/>
			<TextBlock Text="{Binding CurrentRecord}"/>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" HorizontalAlignment="Center" Content="{x:Static assets:Resources.ApplyButtonText}" Command="{Binding RenameApplyCommand}"/>
				<Button Grid.Column="1" HorizontalAlignment="Center" Content="{x:Static assets:Resources.CancelButtonText}" Command="{Binding RemoveAndRenameCancelCommand}"/>
			</Grid>
		</StackPanel>
		<StackPanel x:Key="{x:Static assets:Resources.RenameRecordDialogId}">
			<TextBlock Text="{x:Static assets:Resources.RenameQuestionText}"/>
			<TextBox Text="{Binding CurrentRecord}"/>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" HorizontalAlignment="Center" Content="{x:Static assets:Resources.ApplyButtonText}" Command="{Binding RemoveApplyCommand}"/>
				<Button Grid.Column="1" HorizontalAlignment="Center" Content="{x:Static assets:Resources.CancelButtonText}" Command="{Binding RemoveAndRenameCancelCommand}"/>
			</Grid>
		</StackPanel>
	</Page.Resources>
	<dialogHost:DialogHost CloseOnClickAway="True" Identifier="{x:Static assets:Resources.ListRecordsDialogId}"
                                       BlurBackground="True">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="0.1*"/>
			</Grid.RowDefinitions>
			<ListBox Grid.Row="0" Margin="5" ItemsSource="{Binding Records}" SelectedItem="{Binding CurrentRecord}">

			</ListBox>
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" HorizontalAlignment="Center" Content="{x:Static assets:Resources.AddButtonText}"/>
				<Button Grid.Column="1" HorizontalAlignment="Center" Content="{x:Static assets:Resources.RenameButtonText}" Command="{Binding RenameCommand}"/>
				<Button Grid.Column="2" HorizontalAlignment="Center" Content="{x:Static assets:Resources.RemoveButtonText}" Command="{Binding RemoveCommand}"/>
			</Grid>
		</Grid>
	</dialogHost:DialogHost>
</Page>
