<Page xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	         xmlns:assets="clr-namespace:CrossplatformPasswordManagerPL.Assets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	         x:Class="CrossplatformPasswordManagerPL.Views.Auth.OSAuth"
             NavigationBar.Visible="False"
			 xmlns:vm="clr-namespace:CrossplatformPasswordManagerPL.ViewModels.Auth"
			 x:DataType="vm:OSAuthViewModel">
	<Grid>
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
			<TextBlock Text="{Binding ProcessAuth}" FontSize="18" HorizontalAlignment="Center"></TextBlock>
			<Button IsVisible="{Binding IsFailedProcessAuth}" Command="{Binding RepeatAuthCommand}" Content="{x:Static assets:Resources.RepeatAuthButtonText}" HorizontalAlignment="Center" Margin="30" ></Button>
		</StackPanel>
	</Grid>
</Page>
